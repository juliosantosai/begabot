{
  "name": "begabot-3-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo para BegaBot 3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliosantosai/begabot.git"
  },
  "homepage": "https://github.com/juliosantosai/begabot#readme",
  "workspaces": [
    "gateway-service",
    "buffer-service",
    "core-service",
    "ai-agent-service",
    "media-switcher-service",
    "audit-metrics-service",
    "scheduler-service",
    "dispatcher-service",
    "packages/*"
  ],
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "syncpack": "^10.0.0"
  },
  "scripts": {
    "install:all": "npm install",
    "test": "npm run test --workspaces --if-present",
    "check-deps": "npx syncpack list-mismatches",
    "dev:webhook": "npm --workspace gateway-service run dev",
    "dev:buffer": "npm --workspace buffer-service run dev",
    "dev:ai": "npm --workspace ai-agent-service run start"
  }
}
