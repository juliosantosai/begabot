# Ejemplo de variables de entorno para el monorepo Begabot
# Copia este archivo a .env y ajusta los valores reales.

# Servicios base
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=begabot_user
POSTGRES_PASSWORD=tu_password_seguro_aqui
POSTGRES_DB=begabot_saas
DATABASE_URL=postgresql://begabot_user:tu_password_seguro_aqui@postgres:5432/begabot_saas

# Redis
REDIS_URL=redis://redis:6379

# n8n
N8N_WEBHOOK_URL=https://tu-n8n.example/webhook/begabot-router
N8N_TOKEN=supersecrettoken

# Evolution API
EVOLUTION_API_KEY=tu_evolution_api_key_aqui

# Puertos por servicio
CORE_PORT=3002
BUFFER_PORT=3001
AI_PORT=3003

# Gemini AI
GEMINI_API_KEY=tu_gemini_api_key_aqui
DEFAULT_AI_MODEL=models/gemini-3.1-flash-lite

# URL de servicio-core desde servicio-agente-ia
CORE_SERVICE_URL=http://localhost:3002
