datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model MessageHistory {
  id           String   @id @default(uuid())
  jid          String
  texto        String   @db.Text
  isFromClient Boolean
  source       String
  creadoEn     DateTime @default(now())

  @@index([jid, creadoEn])
}

model Message {
  id        String   @id @default(uuid())
  jid       String
  sender    String
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([jid, createdAt])
}

model SessionMemory {
  jid                String   @id
  state_data         Json     @default("{}")
  conversation_state String?  @default("general")
  conversation_summary String? @db.Text
  updatedAt          DateTime @default(now())
}

model EvolutionApiConfig {
  id            String  @id @default(uuid())
  sender        String  @unique
  serverUrl     String
  apiKey        String
  instancia     String
  negocioNombre String?
  activo        Boolean @default(true)
}

model Prompt {
  id            String   @id @default(uuid())
  sender        String   @unique
  prompt        String   @db.Text
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @default(now())
}

model EstadoConversacion {
  uuid      String   @id @default(uuid())
  jid       String
  sender    String
  bloqueado Boolean  @default(false)
  contexto  Json     @default("{}")
  numero    Int      @default(1)

  @@unique([jid, sender])
}

model Task {
  id                    String   @id @default(uuid())
  estadoConversacionUuid String?
  texto                 String   @db.Text
  fechaEjecucion        DateTime
  estado                String   @default("pendiente")
  creadoEn              DateTime @default(now())
  actualizadoEn         DateTime @default(now())
  eliminado             Boolean  @default(false)
  deletedAt             DateTime?
  payload               Json?
}

model TaskLog {
  id            String   @id @default(uuid())
  tareaId       String
  texto         String   @db.Text
  fechaEjecucion DateTime
  fechaRegistro DateTime @default(now())
  estadoFinal   String
  observacion   String?
}

// Multi-tenant dynamic models
model TenantConfig {
  id        String   @id @default(uuid())
  tenantId  String   @unique @map("tenant_id")
  name      String
  fields    Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenant_configs")
}

model DynamicRecord {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  entityName       String   @map("entity_name")
  recordIdentifier String   @map("record_identifier")
  data             Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, entityName, recordIdentifier])
  @@map("dynamic_records")
}

model SessionMemoryTenant {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  jid                  String   @map("jid")
  memoryPatch          Json     @default("{}") @map("memory_patch")
  conversation_state   String?  @default("general") @map("conversation_state")
  conversation_summary String?  @db.Text @map("conversation_summary")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, jid])
  @@map("session_memories")
}

model MessageTenant {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  jid          String   @map("jid")
  role         String
  content      String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, jid, createdAt(sort: Desc)])
  @@map("messages")
}
